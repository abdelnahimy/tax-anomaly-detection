# --- Données volumineuses -------------------------------------------------
# Le jeu JAR2020 (46 Mo) et sa version transformée (115 Mo) ne sont pas
# versionnés : voir data/raw/README.md pour les instructions de téléchargement.
data/raw/*.csv
data/processed/*.csv

# Les jeux d'exemple et de test marocains SONT versionnés : ils sont fictifs,
# régénérables par script, et servent de gabarit de saisie.
!dashboard/exemple_liasse_marocaine.csv
!dashboard/exemple_donnees.csv
!data/exemples_marocains/*.csv

# --- Exports de liasses réelles -------------------------------------------
# Garde-fou : tout export issu du système d'information de l'administration
# relève du secret professionnel (art. 246 du CGI) et ne doit JAMAIS être
# versionné, même par inadvertance.
exports_dgi/
liasses_reelles/
*_confidentiel*
*_reel.csv

